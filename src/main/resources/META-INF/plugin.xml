<idea-plugin>
    <id>community.intellaspring</id>
    <name>Intella Spring</name>
    <vendor>community</vendor>
    <description><![CDATA[
    Spring &amp; Spring Boot support for IntelliJ IDEA on the free tier: bean model across XML and Java
    configuration, autowiring analysis, gutter navigation, a Spring Boot run configuration with
    actuator tabs, and configuration-metadata completion for application.properties / application.yml.
    <br><br>
    The Spring plugins bundled with IDEA are Ultimate-license-gated; this plugin brings comparable
    assistance to everyone. It depends only on the platform, Java, Properties and YAML support.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.phucngu.intellaspring.spring.SpringContextService"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.phucngu.intellaspring.ui.SpringBeanLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="dev.phucngu.intellaspring.ui.SpringInjectionLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="dev.phucngu.intellaspring.ui.SpringXmlBeanLineMarkerProvider"/>
        <psi.referenceContributor language="XML"
                                  implementation="dev.phucngu.intellaspring.xml.SpringXmlReferenceContributor"/>
        <completion.contributor language="XML"
                                implementationClass="dev.phucngu.intellaspring.xml.SpringXmlCompletionContributor"/>
        <internalFileTemplate name="spring-beans.xml"/>
        <notificationGroup id="IntellaSpring" displayType="BALLOON"/>
        <projectService serviceImplementation="dev.phucngu.intellaspring.config.SpringConfigMetadataService"/>
        <completion.contributor language="Properties"
                                implementationClass="dev.phucngu.intellaspring.config.SpringPropertiesCompletionContributor"/>
        <completion.contributor language="yaml"
                                implementationClass="dev.phucngu.intellaspring.config.SpringYamlCompletionContributor"/>
        <lang.documentationProvider language="Properties"
                                    implementationClass="dev.phucngu.intellaspring.config.SpringConfigKeyDocumentationProvider"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.config.SpringUnknownConfigKeyInspection"
                         language="Properties" shortName="SpringUnknownConfigKey" displayName="Unknown Spring Boot configuration key"
                         groupPath="Java" groupName="Spring" enabledByDefault="true" level="WARNING"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.inspection.SpringAmbiguousMappingInspection"
                         language="JAVA" shortName="SpringAmbiguousMapping" displayName="Ambiguous request mapping"
                         groupPath="Java" groupName="Spring" enabledByDefault="true" level="ERROR"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.inspection.SpringJpaDerivedQueryInspection"
                         language="JAVA" shortName="SpringJpaDerivedQuery" displayName="Spring Data derived query problems"
                         groupPath="Java" groupName="Spring" enabledByDefault="true" level="ERROR"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.inspection.SpringValuePlaceholderInspection"
                         language="JAVA" shortName="SpringValuePlaceholder" displayName="Unresolved @Value placeholder"
                         groupPath="Java" groupName="Spring" enabledByDefault="true" level="WARNING"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.inspection.SpringScheduledCronInspection"
                         language="JAVA" shortName="SpringScheduledCron" displayName="Invalid @Scheduled cron expression"
                         groupPath="Java" groupName="Spring" enabledByDefault="true" level="WARNING"/>
        <configurationType implementation="dev.phucngu.intellaspring.boot.IntellaSpringBootConfigurationType"/>
        <runConfigurationProducer implementation="dev.phucngu.intellaspring.boot.IntellaSpringBootRunConfigurationProducer"/>
        <localInspection implementationClass="dev.phucngu.intellaspring.inspection.SpringAutowiringInspection"
                         language="JAVA" shortName="SpringAutowiringInspection" suppressId="SpringAutowiringInspection"
                         displayName="Spring autowiring problems" groupPath="Java" groupName="Spring"
                         enabledByDefault="true" level="ERROR"/>
        <toolWindow id="Spring Endpoints" anchor="bottom" icon="/icons/springBean.svg"
                    factoryClass="dev.phucngu.intellaspring.endpoints.EndpointsToolWindowFactory"
                    canCloseContents="false"/>
        <toolWindow id="Spring Beans" anchor="bottom" icon="/icons/springBean.svg"
                    factoryClass="dev.phucngu.intellaspring.beans.BeansToolWindowFactory"
                    canCloseContents="false"/>
    </extensions>

    <actions>
        <action id="IntellaSpring.GoToBean"
                class="dev.phucngu.intellaspring.ui.GoToSpringBeanAction"
                text="Spring Bean..."
                description="Jump to a Spring bean definition in this project">
            <add-to-group group-id="GoToMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift B"/>
        </action>
        <action id="IntellaSpring.NewBootProject"
                class="dev.phucngu.intellaspring.initializr.SpringInitializrAction"
                text="Spring Boot Project (Initializr)..."
                description="Generate a new Spring Boot project from start.spring.io">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="dev.phucngu.intellaspring.spring.SpringModelRootListener"
                  topic="com.intellij.openapi.roots.ModuleRootListener"/>
    </projectListeners>
</idea-plugin>
